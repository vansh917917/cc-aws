# Server Configuration
PORT=5000
NODE_ENV=development
INSTANCE_ID=ec2-instance-1

# Storage Driver Options: "local" or "s3"
STORAGE_DRIVER=local

# Local Storage Directory (Used when STORAGE_DRIVER=local)
LOCAL_UPLOAD_DIR=uploads

# Amazon S3 Configuration (Used when STORAGE_DRIVER=s3)
# On EC2, credentials are automatically supplied by the IAM instance role.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name-here

# Amazon SimpleDB Metadata Configuration
# Set ENABLE_SIMPLEDB=true on EC2 to store file metadata in SimpleDB
ENABLE_SIMPLEDB=false
AWS_SIMPLEDB_DOMAIN=student_files_metadata

# Amazon CloudWatch Logs and Metrics Configuration
# Set ENABLE_CLOUDWATCH=true on EC2 to stream logs and publish metrics
ENABLE_CLOUDWATCH=false
CLOUDWATCH_LOG_GROUP=/aws/student-file-manager/backend
CLOUDWATCH_METRIC_NAMESPACE=StudentFileManager

# CORS Origin Configuration
# Set to "*" for open testing, or your ALB / Frontend origin
CORS_ORIGIN=*

# Upload Restrictions
MAX_FILE_SIZE_MB=15
