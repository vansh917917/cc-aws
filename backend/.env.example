# Server Configuration
PORT=5000
NODE_ENV=development

# Storage Driver Options: "local" or "s3"
STORAGE_DRIVER=local

# Local Storage Directory (Used when STORAGE_DRIVER=local)
# Can be a relative path from the backend folder or an absolute path
LOCAL_UPLOAD_DIR=uploads

# Amazon S3 Configuration (Used when STORAGE_DRIVER=s3)
# Note: Do NOT hardcode AWS access keys or secret keys here.
# On EC2, credentials are automatically supplied by the IAM instance role.
# In local development, the AWS SDK loads credentials from ~/.aws/credentials
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name-here

# CORS Origin Configuration
# Set to "*" for open testing, or specific frontend origin: e.g. "http://localhost:3000" or "http://<EC2-FRONTEND-PUBLIC-IP>"
CORS_ORIGIN=*

# Upload Restrictions
MAX_FILE_SIZE_MB=15
